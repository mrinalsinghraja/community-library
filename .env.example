# ---------------------------------------------------------------------------
# Community Children's Library — environment template
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored, and CI runs a
# secret scanner). Every value below is a placeholder: none of them work.
#
# Full documentation of each variable: docs/ENVIRONMENT_VARIABLES.md
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# DATABASE_URL is the POOLED connection, used at runtime.
# DIRECT_URL is the UNPOOLED connection; Prisma migrations must not go through
# a pooler. Neon shows both on the project dashboard.
# Use SEPARATE Neon projects for development and production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Only needed to run the database test suite (npm run test:db).
# Point it at a throwaway database — the tests truncate every table.
TEST_DATABASE_URL="postgresql://localhost:5432/library_test?schema=public"

# --- Authentication ---------------------------------------------------------
# Generate with:  openssl rand -base64 32
# Rotating this invalidates every active session and every pending activation
# link, so rotate deliberately.
AUTH_SECRET="REPLACE_WITH_A_32_BYTE_RANDOM_STRING"

# The canonical origin Auth.js builds callback URLs from.
AUTH_URL="https://library.example.org"
AUTH_TRUST_HOST="true"

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://library.example.org"

# Bootstrap timezone only. Once a library row exists, library_settings.timezone
# is authoritative and this is ignored.
APP_TIMEZONE="Asia/Kolkata"

# --- Email ------------------------------------------------------------------
# brevo | resend | smtp | console
#
# "console" captures messages to ./.mail and opens no socket. That is the right
# default on a laptop and a refusal in production: a deployment set to console
# records every activation link as FAILED rather than pretending it was sent.
#
# "brevo" is what this deployment uses. It is an HTTP API rather than a socket,
# which is the right shape for a serverless function, and its free allowance is
# a daily one rather than a trial.
EMAIL_PROVIDER="console"

# When EMAIL_PROVIDER=brevo — an SMTP/API key from the Brevo dashboard.
BREVO_API_KEY=""

# When EMAIL_PROVIDER=resend
RESEND_API_KEY=""

# When EMAIL_PROVIDER=smtp. Leave SMTP_SECURE unset and it is worked out from
# the port: 465 is TLS from the first byte, 587 and 25 are STARTTLS. Setting it
# to "true" on port 587 does not fail cleanly — the handshake simply hangs.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# SMTP_SECURE="false"

# Required whenever email is actually enabled. The sending domain must have
# SPF and DKIM configured, or activation links land in spam and no family can
# ever complete registration.
EMAIL_FROM="Children's Library <library@example.org>"
EMAIL_REPLY_TO=""

# --- File storage (Vercel Blob) ---------------------------------------------
# Injected automatically by Vercel when a Blob store is linked to the project.
# Only needed locally if you are working on uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token guarding /api/cron/daily so only the scheduler can trigger it.
# Generate with:  openssl rand -base64 32
CRON_SECRET=""

# --- One-time bootstrap -----------------------------------------------------
# There is no bootstrap variable. The first administrator is created with
# `npm run create-admin`, which needs no HTTP route and no default password.
