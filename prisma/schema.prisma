// Community Children's Library Platform — data model
// See docs/DATABASE.md for the narrative explanation and docs/BLUEPRINT.md §6-§7.
//
// Conventions:
//   * every tenant-scoped table carries libraryId, from the first migration
//   * tables and columns are snake_case; Prisma fields stay camelCase
//   * ids are UUIDv7 (time-sortable) generated client-side — no DB extension needed
//   * all timestamps are timestamptz, stored UTC, rendered in library timezone
//   * business rules live in library_settings, never in column defaults that pretend to be policy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserKind {
  STAFF
  MEMBER
  GUARDIAN
}

/// ARCHIVED is the terminal state for a departed member: personal fields are
/// redacted but historical loan rows survive for library records. See DATABASE.md.
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Consent is recorded per purpose so a guardian can withdraw photo storage
/// without withdrawing the account itself.
enum ConsentType {
  CHILD_ACCOUNT_CREATION
  CHILD_PHOTO_STORAGE
  GUARDIAN_EMAIL_NOTIFICATIONS
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
  SUPERSEDED
}

/// How the guardian's consent reached us, and therefore how strongly it is
/// verified. Adding a stronger method later is a new enum value plus a new code
/// path — never a change to the registration workflow or the schema shape.
///
/// WEB_FORM             guardian ticked the box on /join (Version 1 default)
/// EMAIL_CONFIRMATION   guardian additionally confirmed via an emailed link
/// ADMIN_VERIFIED       a librarian confirmed the guardian in person
/// OTHER_VERIFIED_METHOD  reserved for a method a future legal review requires
enum ConsentMethod {
  WEB_FORM
  EMAIL_CONFIRMATION
  ADMIN_VERIFIED
  OTHER_VERIFIED_METHOD
}

/// HOW an adult claiming to be the child's guardian was checked.
///
/// This is a separate axis from ConsentMethod. Consent answers "did a guardian
/// agree, to what wording, when?". Verification answers "what evidence do we
/// have that the person who agreed is the guardian?". A tickbox produces the
/// first and almost none of the second, which is exactly why they are modelled
/// apart — see docs/GUARDIAN_VERIFICATION.md.
///
/// SELF_DECLARED              somebody ticked a box on /join. No verification.
/// EMAIL_CONFIRMATION         the guardian opened a single-use link we emailed.
/// STAFF_VERIFIED             a named staff member confirmed the guardian.
/// VERIFIED_IDENTITY_PROVIDER an external verified-identity service asserted it.
/// OTHER                      a method a future legal review introduces.
///
/// These are TECHNICAL categories. None of them is a claim that the method
/// satisfies any particular legal standard.
enum GuardianVerificationMethod {
  SELF_DECLARED
  EMAIL_CONFIRMATION
  STAFF_VERIFIED
  VERIFIED_IDENTITY_PROVIDER
  OTHER
}

/// Whether the method above actually completed. Ordered weakest to strongest so
/// that a configured minimum can be compared with `>=` in SQL as well as in
/// application code.
enum GuardianVerificationStrength {
  NONE
  SELF_DECLARED
  EMAIL_CONFIRMED
  STAFF_VERIFIED
  IDENTITY_PROVIDER
}

enum GuardianVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

enum CatalogueVisibility {
  MEMBER_ONLY
  PUBLIC
}

/// RESERVED exists so the reservation workflow can be added later without a
/// migration. No Version 1 code path sets it.
enum CopyStatus {
  AVAILABLE
  BORROWED
  RESERVED
  LOST
  DAMAGED
  ARCHIVED
}

/// The three words a librarian actually uses about a physical book. Phase 0 had
/// five; Version 1 of the catalogue deliberately has three, because a dropdown
/// a nine-year-old volunteer can answer correctly beats a taxonomy nobody
/// applies consistently. See docs/CATALOGUE.md.
enum CopyCondition {
  GOOD
  FAIR
  DAMAGED
}

/// Recommended reading age, as a small fixed vocabulary rather than free text.
///
/// Stored structurally so that no part of the application ever parses "8–10
/// years" back into numbers. The bounds and the labels live in exactly one
/// place, src/lib/catalogue.ts, and the human labels are rendered from there.
///
/// These are catalogue *shelf bands*, not the library's membership age range —
/// that stays in library_settings.age_min/age_max and is a different question.
enum AgeGroup {
  AGE_5_7
  AGE_8_10
  AGE_11_14
  ALL_AGES
}

enum AcquisitionType {
  RESIDENT_DONATION
  PURCHASE
  TRANSFER
}

/// Chosen by the donor at intake. Governs every public rendering of the credit.
enum DonorDisplayConsent {
  NAMED
  APARTMENT_ONLY
  ANONYMOUS
}

/// The whole life of a loan, in three words.
///
/// Deliberately has no OVERDUE member: overdue is derived from dueAt < now(),
/// never stored, so no failed job can leave it stale. And deliberately no LOST
/// member either — "lost" is a fact about the physical book, which is what
/// `CopyStatus` is for. A loan is a record of a book going out and coming back;
/// conflating the two would give the library two places to ask "where is it?"
/// and let them disagree.
///
/// CANCELLED exists for exactly one situation: an issue that should not have
/// happened, reversed at the desk moments later. It is not a soft delete. The
/// row stays, the events stay, and the book returns to the shelf.
enum LoanStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

/// Append-only history. One row per thing that happened to a loan.
///
/// MARK_DAMAGED is a loan event and not only a catalogue one because a book
/// coming back damaged happened *during this loan*, and the desk needs to be
/// able to read that from the loan rather than by correlating timestamps.
enum LoanEventType {
  ISSUE
  RENEW
  RETURN
  CANCEL
  MARK_DAMAGED
  CORRECT
}

enum RenewalRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum AuthTokenType {
  ACTIVATION
  PASSWORD_RESET
}

enum AnnouncementAudience {
  ALL
  MEMBERS
  STAFF
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// PRIVATE objects are never served from a public URL. Child photographs are
/// always PRIVATE; generic avatars are static assets and need no row at all.
enum MediaVisibility {
  PUBLIC
  PRIVATE
}

// ---------------------------------------------------------------------------
// Tenancy and configuration
// ---------------------------------------------------------------------------

model Community {
  id          String    @id @default(uuid(7))
  name        String
  slug        String    @unique
  addressLine String?   @map("address_line")
  city        String?
  country     String    @default("India")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  libraries   Library[]

  @@map("community")
}

model Library {
  id          String   @id @default(uuid(7))
  communityId String   @map("community_id")
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  community Community       @relation(fields: [communityId], references: [id], onDelete: Restrict)
  settings  LibrarySettings?

  users                AppUser[]
  roles                Role[]
  guardians            Guardian[]
  registrationRequests RegistrationRequest[]
  consentRecords       ConsentRecord[]
  guardianVerifications GuardianVerification[]
  categories           BookCategory[]
  bookTitles           BookTitle[]
  bookCopies           BookCopy[]
  donations            Donation[]
  loans                Loan[]
  auditLogs            AuditLog[]
  announcements        Announcement[]
  emailEvents          EmailEvent[]
  loginAttempts        LoginAttempt[]
  mediaObjects         MediaObject[]
  codeSequences        CodeSequence[]

  @@index([communityId])
  @@map("library")
}

/// Every configurable business rule lives here. Application code reads these
/// through getLibrarySettings() and never hard-codes an equivalent literal.
model LibrarySettings {
  libraryId String @id @map("library_id")

  // Membership
  ageMin Int @default(5) @map("age_min")
  ageMax Int @default(14) @map("age_max")

  // Borrowing
  //
  // Every circulation rule the library has is one of these numbers. Nothing in
  // src/ writes `14`, `2` or `1` into a business decision; the service reads
  // this row and the tests set their own values on their own fixture library.
  borrowingPeriodDays      Int     @default(14) @map("borrowing_period_days")
  maxActiveLoans           Int     @default(2) @map("max_active_loans")
  maxRenewals              Int     @default(1) @map("max_renewals")
  /// Days added to the CURRENT due date when a loan is renewed — not to today.
  /// A child who renews early is not punished for it by losing the days they
  /// had left. See docs/CIRCULATION.md §"Renewal".
  renewalPeriodDays        Int     @default(7) @map("renewal_period_days")
  /// NOT IMPLEMENTED, and cannot be: there are no reservations in Version 1, so
  /// there is no state for this to describe.
  renewalBlockedWhenReserved Boolean @default(true) @map("renewal_blocked_when_reserved")

  /// May a loan already past its due date be renewed?
  ///
  /// Default false, which is the library's policy: bring the book to the desk,
  /// the librarian returns it, and it can go out again the same minute. That
  /// keeps "renew" meaning "you still have it and we know where it is" rather
  /// than becoming a way to never come back.
  ///
  /// A setting and not a constant because it is a community's decision, and a
  /// library that would rather a child renewed than kept it silently can change
  /// one row. See docs/CIRCULATION.md §"Overdue and renewal".
  allowRenewalWhenOverdue Boolean @default(false) @map("allow_renewal_when_overdue")

  /// NOT IMPLEMENTED. Sketched in the blueprint as "refuse to lend to a child
  /// with something this many days overdue", and deliberately left unwired
  /// through Phase 3: it is a rule that would turn a late book into a closed
  /// door for a nine-year-old, and whether this library wants that is the
  /// owner's decision, not a default the code should assume. Changing this
  /// value today does nothing at all. Nothing reads it; a test says so.
  blockOnOverdueDays       Int     @default(7) @map("block_on_overdue_days")
  /// NOT IMPLEMENTED. Phase 3 sends no notifications of any kind.
  overdueReminderOffsets   Int[]   @default([-2, 0, 3, 7]) @map("overdue_reminder_offsets")

  // Identifiers
  copyCodePrefix   String @default("LIB-B") @map("copy_code_prefix")
  copyCodePadding  Int    @default(4) @map("copy_code_padding")
  memberCodePrefix String @default("LIB-R") @map("member_code_prefix")
  memberCodePadding Int   @default(4) @map("member_code_padding")

  // Visibility and privacy
  catalogueVisibility CatalogueVisibility @default(MEMBER_ONLY) @map("catalogue_visibility")
  donorDisplayDefault DonorDisplayConsent @default(NAMED) @map("donor_display_default")

  // Branding
  logoUrl        String? @map("logo_url")
  faviconUrl     String? @map("favicon_url")
  primaryColor   String  @default("#1F6F5C") @map("primary_color")
  secondaryColor String  @default("#E4572E") @map("secondary_color")
  welcomeMessage String? @map("welcome_message")

  // Contact and policy copy
  contactEmail          String? @map("contact_email")
  contactPhone          String? @map("contact_phone")
  rulesMarkdown         String? @map("rules_markdown")
  donationPolicyMarkdown String? @map("donation_policy_markdown")

  // Consent
  consentVersion String @default("2026-08-v1") @map("consent_version")

  /// Guardian verification (distinct from consent — see GUARDIAN_VERIFICATION.md).
  ///
  /// The minimum verification strength a registration must reach before an
  /// account may be approved and before it may become ACTIVE. Deliberately a
  /// setting and not a constant: what the applicable law requires is a legal
  /// question this software must not answer for a deployment.
  ///
  /// SELF_DECLARED is the DEVELOPMENT default. It means "a box was ticked" and
  /// is not a claim of verification.
  requiredGuardianVerification GuardianVerificationStrength @default(SELF_DECLARED) @map("required_guardian_verification")
  guardianVerificationVersion  String                       @default("2026-08-v1") @map("guardian_verification_version")

  // System
  timezone                 String  @default("Asia/Kolkata")
  dateFormat               String  @default("d MMM yyyy") @map("date_format")
  emailEnabled             Boolean @default(false) @map("email_enabled")
  overdueRemindersEnabled  Boolean @default(false) @map("overdue_reminders_enabled")

  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by_id")

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@map("library_settings")
}

// ---------------------------------------------------------------------------
// Identity, roles and permissions
// ---------------------------------------------------------------------------

/// One row per person who can sign in. A child's identity is memberCode or
/// username — never an email address, because children in this age range
/// mostly do not have one. Guardians are contactable but do not sign in in v1.
model AppUser {
  id          String     @id @default(uuid(7))
  libraryId   String     @map("library_id")
  kind        UserKind
  displayName String     @map("display_name")
  email       String?
  username    String?
  passwordHash String?   @map("password_hash")
  status      UserStatus @default(INVITED)

  mustSetPassword  Boolean   @default(true) @map("must_set_password")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)

  /// When the password was last set or changed. Sessions created before this
  /// moment are not trusted, which is what makes "reset the password and every
  /// other device is signed out" true rather than aspirational.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)

  /// Internal reason for the current status, written by staff when suspending or
  /// deactivating. STAFF-ONLY: never rendered to the account holder, who sees a
  /// generic message. Guarded by the member.suspend permission.
  statusReason      String?   @map("status_reason")
  statusChangedAt   DateTime? @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById String?   @map("status_changed_by_id")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by_id")

  library       Library        @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  memberProfile MemberProfile?
  userRoles     UserRole[]
  sessions      Session[]
  authTokens    AuthToken[]
  guardianLinks GuardianMember[]

  loans            Loan[]           @relation("LoanBorrower")
  loansIssued      Loan[]           @relation("LoanIssuedBy")
  loansReturned    Loan[]           @relation("LoanReturnedBy")
  loansCancelled   Loan[]           @relation("LoanCancelledBy")
  loanEvents       LoanEvent[]
  renewalRequests  RenewalRequest[] @relation("RenewalRequester")
  renewalDecisions RenewalRequest[] @relation("RenewalDecider")
  auditLogs        AuditLog[]
  donationsGiven   Donation[]       @relation("DonationDonor")
  donationsRecorded Donation[]      @relation("DonationRecorder")
  mediaUploaded    MediaObject[]
  reviewedRequests RegistrationRequest[] @relation("RegistrationReviewer")
  recordedConsents ConsentRecord[]  @relation("ConsentRecorder")

  guardianVerifications  GuardianVerification[] @relation("GuardianVerificationSubject")
  verificationsPerformed GuardianVerification[] @relation("GuardianVerifier")

  @@unique([libraryId, email], map: "app_user_library_email_key")
  @@unique([libraryId, username], map: "app_user_library_username_key")
  @@index([libraryId, kind, status])
  @@map("app_user")
}

/// Roles are rows, not code branches. Adding JUNIOR_LIBRARIAN later is a seed
/// change plus a permission mapping — no application code changes.
model Role {
  id          String  @id @default(uuid(7))
  libraryId   String? @map("library_id")
  key         String
  name        String
  description String?
  /// System roles cannot be renamed or deleted from the admin UI.
  isSystem    Boolean @default(true) @map("is_system")
  /// Seeded but not assignable yet (used for JUNIOR_LIBRARIAN in v1).
  isAssignable Boolean @default(true) @map("is_assignable")
  sortOrder   Int     @default(100) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  library         Library?         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([libraryId, key], map: "role_library_key_key")
  @@map("role")
}

model Permission {
  key         String @id
  category    String
  description String

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

model UserRole {
  userId      String   @map("user_id")
  roleId      String   @map("role_id")
  grantedById String?  @map("granted_by_id")
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// The child's library card. Split from app_user so that login identity and
/// library-card data have separate lifecycles and separate access rules.
model MemberProfile {
  userId    String @id @map("user_id")
  libraryId String @map("library_id")

  memberCode  String    @map("member_code")
  dateOfBirth DateTime  @map("date_of_birth") @db.Date
  apartment   String
  avatarKey   String?   @map("avatar_key")
  photoMediaId String?  @unique @map("photo_media_id")
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// Librarian-only notes. Never exposed to any member-facing surface.
  staffNotes  String?   @map("staff_notes")

  user       AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoMedia MediaObject? @relation(fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@unique([libraryId, memberCode], map: "member_profile_library_code_key")
  @@index([libraryId, apartment])
  @@map("member_profile")
}

/// A guardian is a contactable adult, not a borrower. Their contact details sit
/// behind the member.view_contact permission and never render on a child screen.
model Guardian {
  id        String  @id @default(uuid(7))
  libraryId String  @map("library_id")
  fullName  String  @map("full_name")
  email     String
  phone     String
  apartment String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  library        Library          @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  memberLinks    GuardianMember[]
  consentRecords ConsentRecord[]
  verifications  GuardianVerification[]

  @@unique([libraryId, email], map: "guardian_library_email_key")
  @@index([libraryId, apartment])
  @@map("guardian")
}

model GuardianMember {
  guardianId   String  @map("guardian_id")
  memberUserId String  @map("member_user_id")
  relationship String  @default("guardian")
  isPrimary    Boolean @default(true) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  member   AppUser  @relation(fields: [memberUserId], references: [id], onDelete: Cascade)

  @@id([guardianId, memberUserId])
  @@index([memberUserId])
  @@map("guardian_member")
}

// ---------------------------------------------------------------------------
// Registration and consent
// ---------------------------------------------------------------------------

model RegistrationRequest {
  id        String             @id @default(uuid(7))
  libraryId String             @map("library_id")
  status    RegistrationStatus @default(PENDING)

  childName     String   @map("child_name")
  childDob      DateTime @map("child_dob") @db.Date
  apartment     String
  guardianName  String   @map("guardian_name")
  guardianEmail String   @map("guardian_email")
  guardianPhone String   @map("guardian_phone")
  avatarKey     String?  @map("avatar_key")
  photoMediaId  String?  @map("photo_media_id")

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedById String?  @map("reviewed_by_id")
  /// Internal note. Never sent verbatim to the guardian.
  reviewNote  String?   @map("review_note")

  createdMemberUserId String? @unique @map("created_member_user_id")

  /// Truncated, salted hash only — never a raw IP. Retained for abuse handling.
  submittedIpHash String? @map("submitted_ip_hash")

  library    Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  reviewedBy AppUser?        @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  photoMedia MediaObject?    @relation(fields: [photoMediaId], references: [id], onDelete: SetNull)
  consents   ConsentRecord[]
  verifications GuardianVerification[]

  @@index([libraryId, status, submittedAt])
  @@map("registration_request")
}

/// A first-class consent ledger, not a boolean. Rows are append-only in spirit:
/// a withdrawal sets withdrawnAt and status, it never deletes the grant.
/// See docs/SECURITY.md — the wording and verification strength still require
/// legal review before production launch.
model ConsentRecord {
  id        String        @id @default(uuid(7))
  libraryId String        @map("library_id")
  type      ConsentType
  status    ConsentStatus @default(GRANTED)
  method    ConsentMethod @default(WEB_FORM)

  /// Version of the consent wording that was actually shown when granted.
  consentVersion String @map("consent_version")
  /// Verbatim snapshot of the text the guardian agreed to, so a later wording
  /// change can never rewrite history.
  consentTextSnapshot String @map("consent_text_snapshot")

  guardianId            String? @map("guardian_id")
  memberUserId          String? @map("member_user_id")
  registrationRequestId String? @map("registration_request_id")

  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  /// Staff member who recorded an in-person consent; null for online forms.
  recordedById String?  @map("recorded_by_id")

  /// Salted hash only. Justified as evidence that a specific submission occurred.
  ipHash        String? @map("ip_hash")
  userAgentHash String? @map("user_agent_hash")

  library             Library              @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  guardian            Guardian?            @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  registrationRequest RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: SetNull)
  recordedBy          AppUser?             @relation("ConsentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([libraryId, type, status])
  @@index([memberUserId])
  @@index([guardianId])
  @@map("consent_record")
}

/// Evidence about WHO gave the consent, kept apart from the consent itself.
///
/// A ConsentRecord says a guardian agreed to specific wording. A
/// GuardianVerification says how confident the library is that the person who
/// agreed is really the child's guardian. Merging the two would make it
/// impossible to raise the verification bar later without rewriting consent
/// history, and would let a tickbox masquerade as a verified identity.
///
/// Deliberately stores NO identity documents, NO Aadhaar or other government
/// identifier, and NO scanned artefacts. `evidenceNote` is a short free-text
/// note by a staff member ("spoke to her at the desk on Saturday") and a CHECK
/// keeps it short enough that it cannot become a document store by habit.
model GuardianVerification {
  id        String                       @id @default(uuid(7))
  libraryId String                       @map("library_id")
  method    GuardianVerificationMethod
  status    GuardianVerificationStatus   @default(PENDING)
  /// What this method is worth. Derived from the method at creation time by
  /// src/lib/guardian-verification.ts, then frozen: re-scoring an old record
  /// because policy changed would rewrite history.
  strength  GuardianVerificationStrength

  /// Version of the verification policy in force when this was recorded.
  verificationVersion String @map("verification_version")

  /// Exactly one subject is required, enforced by a CHECK constraint. A
  /// verification recorded during registration attaches to the request; once the
  /// account exists it also carries the guardian and the member.
  guardianId            String? @map("guardian_id")
  memberUserId          String? @map("member_user_id")
  registrationRequestId String? @map("registration_request_id")

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  /// Set when a method needs periodic reconfirmation. Null means no expiry.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// The staff member who performed a STAFF_VERIFIED check. Required for that
  /// method by a CHECK constraint: "a human confirmed it" is worthless without
  /// which human.
  performedById String? @map("performed_by_id")
  /// Short staff note. NEVER an identity document reference.
  evidenceNote  String? @map("evidence_note")

  /// Single-use challenge for EMAIL_CONFIRMATION. Only the SHA-256 is stored,
  /// exactly as for activation and reset tokens.
  challengeTokenHash String?   @unique @map("challenge_token_hash")
  challengeExpiresAt DateTime? @map("challenge_expires_at") @db.Timestamptz(6)
  challengeAttempts  Int       @default(0) @map("challenge_attempts")

  ipHash        String? @map("ip_hash")
  userAgentHash String? @map("user_agent_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  library             Library              @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  guardian            Guardian?            @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  member              AppUser?             @relation("GuardianVerificationSubject", fields: [memberUserId], references: [id], onDelete: Cascade)
  registrationRequest RegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: SetNull)
  performedBy         AppUser?             @relation("GuardianVerifier", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([libraryId, status, strength])
  @@index([registrationRequestId])
  @@index([memberUserId])
  @@index([guardianId])
  @@map("guardian_verification")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Shelves, in the sense a child understands: "where do the comics live?".
///
/// A table rather than an enum so that an administrator can add one later
/// without a deploy. Version 1 seeds exactly seven — a short list somebody can
/// actually choose from beats a taxonomy nobody applies consistently.
model BookCategory {
  id        String  @id @default(uuid(7))
  libraryId String  @map("library_id")
  name      String
  slug      String
  icon      String?
  sortOrder Int     @default(100) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  bookTitles BookTitle[]

  @@unique([libraryId, slug], map: "book_category_library_slug_key")
  @@map("book_category")
}

/// What the book *is*: one row per work, however many physical copies exist.
///
/// Deliberately holds no ISBN, publisher, publication year, series, language,
/// description, tags, ratings or reviews. Version 1 of this catalogue is run by
/// volunteers and read by children; every field it does not have is a field
/// nobody has to fill in, get wrong, or maintain. See docs/CATALOGUE.md §2.
///
/// `authors` stays an array because the search index is built over it and a
/// second author costs nothing to store. The Add Book form offers a single
/// Author box, which is all Version 1 exposes.
model BookTitle {
  id           String   @id @default(uuid(7))
  libraryId    String   @map("library_id")
  title        String
  authors      String[]
  /// Recommended reading age band. Required: a book with no shelf band cannot
  /// be filtered, and "which of these is for me?" is the question the child
  /// catalogue exists to answer.
  ageGroup     AgeGroup @map("age_group")
  categoryId   String   @map("category_id")
  coverMediaId String?  @map("cover_media_id")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by_id")

  library  Library      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: a category with books on its shelf cannot be deleted
  // out from under them, and every title always has one.
  category BookCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // SetNull: losing a cover picture must never take the book off the shelf.
  coverMedia MediaObject? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  copies     BookCopy[]

  @@index([libraryId, categoryId])
  @@index([libraryId, ageGroup])
  @@map("book_title")
}

/// A physical object on a shelf, with its own permanent code, condition and
/// history. Codes are never reused, even after archiving.
///
/// `status` is the field the phase boundary runs through. Phase 2 lets a
/// librarian set the initial status and correct a mistake; the AVAILABLE ↔
/// BORROWED transition belongs to Phase 3 circulation and no Phase 2 code path
/// performs it. RESERVED is reserved for the same reason and nothing sets it.
/// ARCHIVED is how a book leaves the shelf permanently — nothing is ever
/// hard-deleted, so the donation and its history survive.
model BookCopy {
  id        String          @id @default(uuid(7))
  libraryId String          @map("library_id")
  titleId   String          @map("title_id")
  copyCode  String          @map("copy_code")
  status    CopyStatus      @default(AVAILABLE)
  condition CopyCondition   @default(GOOD)
  acquisitionType AcquisitionType @default(RESIDENT_DONATION) @map("acquisition_type")

  shelfLocation String?   @map("shelf_location")
  acquiredAt    DateTime  @default(now()) @map("acquired_at") @db.Timestamptz(6)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  library  Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  title    BookTitle @relation(fields: [titleId], references: [id], onDelete: Restrict)
  donation Donation?
  loans    Loan[]

  @@unique([libraryId, copyCode], map: "book_copy_library_code_key")
  @@index([libraryId, status])
  @@index([libraryId, condition])
  @@index([titleId])
  @@map("book_copy")
}

/// Attached to a copy, not a title: the community gave this particular book.
/// displayConsent governs every public rendering.
///
/// Two deliberate absences:
///
///   * **No contact details.** A name and a flat number are enough to say thank
///     you. No phone, no email, no address, no identity document — the
///     catalogue is not a directory of who lives where with what number.
///   * **No aggregate, count, rank or score column, anywhere.** There is no
///     "top donor", no leaderboard, no most-generous-family. Gratitude, not
///     competition. A schema with no counter cannot grow a leaderboard by
///     accident.
model Donation {
  id        String @id @default(uuid(7))
  libraryId String @map("library_id")
  copyId    String @unique @map("copy_id")

  donorName      String              @map("donor_name")
  donorApartment String?             @map("donor_apartment")
  donorUserId    String?             @map("donor_user_id")
  displayConsent DonorDisplayConsent @default(NAMED) @map("display_consent")
  donatedAt      DateTime            @default(now()) @map("donated_at") @db.Timestamptz(6)
  note           String?

  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  copy       BookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  donorUser  AppUser? @relation("DonationDonor", fields: [donorUserId], references: [id], onDelete: SetNull)
  recordedBy AppUser? @relation("DonationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([libraryId, donatedAt])
  @@map("donation")
}

// ---------------------------------------------------------------------------
// Circulation
// ---------------------------------------------------------------------------

/// Current state of one borrowing. A partial unique index on (copy_id) WHERE
/// status = 'ACTIVE' makes a double issue impossible at the database level —
/// see the migration SQL. Overdue is NOT a column: it is dueAt < now().
model Loan {
  id           String     @id @default(uuid(7))
  libraryId    String     @map("library_id")
  copyId       String     @map("copy_id")
  memberUserId String     @map("member_user_id")
  status       LoanStatus @default(ACTIVE)

  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById   String?   @map("issued_by_id")
  /// The due date this loan actually has, computed once when it was issued (and
  /// again on each renewal) and then stored. NEVER re-derived from the current
  /// library settings: changing the borrowing period from 14 days to 21 must
  /// not silently move the date on a book already in a child's bag.
  dueAt        DateTime  @map("due_at") @db.Timestamptz(6)
  returnedAt   DateTime? @map("returned_at") @db.Timestamptz(6)
  returnedById String?   @map("returned_by_id")
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById String?   @map("cancelled_by_id")
  renewalCount Int       @default(0) @map("renewal_count")

  library    Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  copy       BookCopy @relation(fields: [copyId], references: [id], onDelete: Restrict)
  member     AppUser  @relation("LoanBorrower", fields: [memberUserId], references: [id], onDelete: Restrict)
  issuedBy   AppUser? @relation("LoanIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedBy AppUser? @relation("LoanReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  cancelledBy AppUser? @relation("LoanCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  events          LoanEvent[]
  renewalRequests RenewalRequest[]

  @@index([libraryId, status, dueAt])
  @@index([memberUserId, status])
  @@index([copyId])
  @@map("loan")
}

/// Append-only history. Renewals and due-date adjustments add rows; they never
/// overwrite the story of what happened.
model LoanEvent {
  id     String        @id @default(uuid(7))
  loanId String        @map("loan_id")
  type   LoanEventType

  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId  String?   @map("actor_user_id")
  previousDueAt DateTime? @map("previous_due_at") @db.Timestamptz(6)
  newDueAt     DateTime? @map("new_due_at") @db.Timestamptz(6)
  note         String?

  loan  Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  actor AppUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([loanId, occurredAt])
  @@map("loan_event")
}

/// A child may ask to keep a book longer; a librarian decides. Children never
/// mutate a loan directly in v1.
model RenewalRequest {
  id     String               @id @default(uuid(7))
  loanId String               @map("loan_id")
  status RenewalRequestStatus @default(PENDING)

  requestedById String   @map("requested_by_id")
  requestedAt   DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById   String?  @map("decided_by_id")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?  @map("decision_note")

  loan        Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  requestedBy AppUser @relation("RenewalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   AppUser? @relation("RenewalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([loanId, status])
  @@map("renewal_request")
}

/// Allocator for human-facing codes (LIB-B0001 for a book, LIB-R0042 for a card).
/// The two kinds are separate sequences with separate prefixes, so the seventh
/// book and the seventh card share a number but never a string. Nothing in the
/// application decides what a code refers to by reading its prefix.
/// Allocation is a single atomic `UPDATE ... RETURNING`, which takes a row lock
/// for the duration of the statement. Two librarians adding books at the same
/// moment therefore cannot receive the same number — there is no read-then-write
/// window to race. Codes are never reused, even after a copy is archived.
model CodeSequence {
  libraryId String   @map("library_id")
  /// "BOOK_COPY" or "MEMBER".
  kind      String
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@id([libraryId, kind])
  @@map("code_sequence")
}

// ---------------------------------------------------------------------------
// Sessions, tokens and platform tables
// ---------------------------------------------------------------------------

/// Server-side session records. The cookie carries an opaque random handle;
/// only its SHA-256 hash is stored here, so a database dump yields no usable
/// sessions. Deleting rows for a user revokes their access on the next request.
model Session {
  id        String @id @default(uuid(7))
  userId    String @map("user_id")
  tokenHash String @unique @map("token_hash")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute expiry — a session dies at this moment however active it is.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Idle expiry — refreshed on activity, always <= expiresAt.
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  userAgentHash String? @map("user_agent_hash")
  ipHash        String? @map("ip_hash")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Single-use, time-limited activation and password-reset tokens. Only the hash
/// is stored; the raw token exists solely inside the emailed link.
model AuthToken {
  id     String        @id @default(uuid(7))
  userId String        @map("user_id")
  type   AuthTokenType

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  /// Explicitly cancelled — by a staff member reissuing a link, or superseded
  /// by a newer token of the same type. Distinct from consumed and from expired
  /// so the audit trail can tell the three apart.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Salted hash of the requesting IP. Kept for abuse handling only.
  requestedIpHash String? @map("requested_ip_hash")
  /// How many times this token has been presented. A spike on a spent token is
  /// a signal worth being able to see.
  attemptCount    Int     @default(0) @map("attempt_count")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by_id")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_token")
}

/// Backs login throttling without requiring Redis. Identifier and IP are stored
/// as salted hashes, never in the clear.
model LoginAttempt {
  id             String   @id @default(uuid(7))
  libraryId      String?  @map("library_id")
  identifierHash String   @map("identifier_hash")
  ipHash         String?  @map("ip_hash")
  succeeded      Boolean
  attemptedAt    DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  library Library? @relation(fields: [libraryId], references: [id], onDelete: SetNull)

  @@index([identifierHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@map("login_attempt")
}

/// Written in the same transaction as the change it describes.
/// Never contains passwords, tokens, hashes or secrets.
model AuditLog {
  id        String @id @default(uuid(7))
  libraryId String @map("library_id")

  actorUserId String? @map("actor_user_id")
  /// Denormalised label so the log stays readable after an account is archived.
  actorLabel  String  @map("actor_label")
  action      String
  entityType  String  @map("entity_type")
  entityId    String? @map("entity_id")
  metadata    Json?
  ipHash      String? @map("ip_hash")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  library Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  actor   AppUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([libraryId, occurredAt])
  @@index([libraryId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

model Announcement {
  id        String               @id @default(uuid(7))
  libraryId String               @map("library_id")
  title     String
  bodyMarkdown String            @map("body_markdown")
  audience  AnnouncementAudience @default(ALL)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, audience, publishedAt])
  @@map("announcement")
}

/// Delivery log so "did the guardian get the activation link?" is answerable.
model EmailEvent {
  id        String      @id @default(uuid(7))
  libraryId String      @map("library_id")
  recipient String
  template  String
  subject   String
  status    EmailStatus @default(QUEUED)

  providerMessageId String? @map("provider_message_id")
  error             String?
  relatedEntityType String? @map("related_entity_type")
  relatedEntityId   String? @map("related_entity_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@map("email_event")
}

/// Tracks every uploaded object so private media can be authorized before it is
/// served. Child photographs are always PRIVATE and reachable only through
/// /api/media/[id] after an ownership or permission check.
model MediaObject {
  id         String          @id @default(uuid(7))
  libraryId  String          @map("library_id")
  visibility MediaVisibility @default(PRIVATE)

  /// Opaque storage key. Never derived from the uploaded filename.
  storageKey  String  @unique @map("storage_key")
  /// Only set for PUBLIC objects.
  publicUrl   String? @map("public_url")
  mimeType    String  @map("mime_type")
  byteSize    Int     @map("byte_size")
  width       Int?
  height      Int?
  checksumSha256 String @map("checksum_sha256")
  purpose     String

  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The row is the ledger; the bytes follow it.
  ///
  /// A database transaction and an object-store write cannot be made atomic, so
  /// this system never tries. Instead every object is born with a deadline and
  /// nothing is ever deleted from storage while a live row still points at it:
  ///
  ///   * on upload  — set to "unclaimed after N minutes". Whatever claims the
  ///     object (a registration request, a member profile) clears it in the same
  ///     transaction that links it. An upload nobody claims is swept away.
  ///   * on removal or replacement — set to now() inside the transaction that
  ///     unlinks it, then the bytes are deleted immediately on a best-effort
  ///     basis. If that fails, the sweeper retries; the row cannot be lost, so
  ///     the bytes cannot become unreachable garbage.
  ///
  /// Consequence: a private child photograph never outlives its row, and a
  /// failed request never leaves an object no query can find.
  pendingDeletionAt DateTime? @map("pending_deletion_at") @db.Timestamptz(6)
  /// Sweep attempts, so a permanently failing object is visible rather than
  /// retried forever in silence.
  deleteAttempts    Int       @default(0) @map("delete_attempts")

  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  uploadedBy AppUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  memberProfile       MemberProfile?
  registrationRequests RegistrationRequest[]
  bookTitles          BookTitle[]

  @@index([libraryId, purpose])
  @@index([pendingDeletionAt])
  @@map("media_object")
}
