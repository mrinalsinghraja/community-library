{
  "name": "community-library",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/check-env.ts",
    "build": "prisma generate && next build",
    "prestart": "tsx scripts/check-env.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:demo": "tsx prisma/seed/index.ts --demo",
    "create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project database",
    "test:all": "vitest run",
    "test:coverage": "vitest run --project unit --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "reconcile:circulation": "tsx scripts/reconcile-circulation.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "date-fns": "^4.4.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
